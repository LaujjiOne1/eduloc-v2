# Copier en .env (ignoré par Git) ou déclarer dans EAS. Voir SOCIAL_LOGIN.md.

# --- Connexion Google ---------------------------------------------------------------------------------------------
# Client OAuth de type « Web » : aussi à mettre dans GOOGLE_CLIENT_IDS du backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Client OAuth iOS (facultatif : inutile tant que l'application n'est que sur Android).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Connexion Facebook (Meta) ------------------------------------------------------------------------------------
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Jeton client de l'application Meta : utilisé au build seulement (jamais dans le bundle JavaScript).
FACEBOOK_CLIENT_TOKEN=
# Le secret de l'application (FACEBOOK_APP_SECRET) ne va JAMAIS ici : il reste côté serveur.
