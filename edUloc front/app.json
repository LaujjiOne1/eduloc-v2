{
  "expo": {
    "name": "edUloc",
    "slug": "edUloc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eduloc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "EduLoc utilise la caméra pour les appels vidéo avec votre tuteur ou votre élève.",
        "NSMicrophoneUsageDescription": "EduLoc utilise le micro pour enregistrer vos messages vocaux et passer des appels.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "CFBundleLocalizations": [
          "fr",
          "en",
          "mg"
        ]
      },
      "bundleIdentifier": "mg.eduloc.app"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mg.eduloc.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "@livekit/react-native-expo-plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "EduLoc accède à votre photothèque pour sélectionner votre photo de profil ou votre vidéo de présentation.",
          "cameraPermission": "EduLoc utilise l'appareil photo pour prendre votre photo de profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#211C5E"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "EduLoc utilise le micro pour enregistrer vos messages vocaux et passer des appels."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#332E86",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/ringtone.wav",
            "./assets/sounds/ringtone-call.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EduLoc utilise votre position pour trouver des tuteurs près de chez vous."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "mg"
            ],
            "android": [
              "fr",
              "en",
              "mg"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "EduLoc utilise Face ID pour déverrouiller votre mot de passe ou votre session enregistrés."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "mg": "./locales/mg.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c196eba1-cc0f-4d57-9755-de64e2490861"
      }
    },
    "owner": "laujjione"
  }
}
