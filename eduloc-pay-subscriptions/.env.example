# Service de paiement EduLoc — copier en .env (ignoré par Git). Générer un secret : openssl rand -hex 32
PORT=3001

# Adresse PUBLIQUE de ce service (ngrok en développement) : retours des opérateurs Mobile Money. HTTPS obligatoire en production.
PAY_SERVICE_PUBLIC_URL=

# Secrets partagés avec le backend EduLoc (>= 32 caractères, DIFFÉRENTS l'un de l'autre) :
#   PAY_TICKET_SECRET  = même valeur que PAY_TICKET_SECRET du backend (vérifie les tickets)
#   PAY_WEBHOOK_SECRET = même valeur que PAY_WEBHOOK_SECRET du backend (signe les notifications)
PAY_TICKET_SECRET=
PAY_WEBHOOK_SECRET=
# Adresse de notification d'EduLoc (https://<ngrok-backend>/api/payments/webhook). Vide : celle du ticket est utilisée.
EDULOC_WEBHOOK_URL=
# Clé que le backend EduLoc présente pour lire un statut (= PAY_API_KEY du backend).
PAY_STATUS_API_KEY=

# CRM Odoo : SEUL lieu de stockage des paiements (module eduloc_payments). Jeton = EDULOC_PAYMENTS_TOKEN d'Odoo.
ODOO_URL=http://localhost:8069
ODOO_PAYMENTS_TOKEN=

# Carte (Visa / Mastercard) — Stripe, mode TEST : clés sk_test_… / pk_test_…, secret du endpoint /api/v1/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mobile Money — MVola (sandbox : https://devapi.mvola.mg). Vide : MVola masqué dans la page de paiement.
MVOLA_BASE_URL=https://devapi.mvola.mg
MVOLA_CLIENT_ID=
MVOLA_CLIENT_SECRET=
MVOLA_MERCHANT_MSISDN=
MVOLA_PARTNER_NAME=EduLoc
