<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eduloc_payment_view_list" model="ir.ui.view">
        <field name="name">eduloc.payment.list</field>
        <field name="model">eduloc.payment</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="has_anomaly" decoration-success="status == 'succeeded'" decoration-muted="status in ('failed', 'cancelled', 'expired')">
                <field name="create_date" string="Créé le"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="currency"/>
                <field name="method"/>
                <field name="provider"/>
                <field name="status" widget="badge" decoration-success="status == 'succeeded'" decoration-warning="status == 'pending'" decoration-danger="status == 'failed'"/>
                <field name="last_verified_at"/>
                <field name="has_anomaly" string="Anomalie"/>
            </list>
        </field>
    </record>

    <record id="eduloc_payment_view_form" model="ir.ui.view">
        <field name="name">eduloc.payment.form</field>
        <field name="model">eduloc.payment</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Paiement">
                            <field name="status" widget="badge"/>
                            <field name="amount"/>
                            <field name="currency"/>
                            <field name="method"/>
                            <field name="provider"/>
                            <field name="provider_ref"/>
                            <field name="card_brand"/>
                            <field name="card_last4"/>
                            <field name="settled_at"/>
                            <field name="last_verified_at"/>
                        </group>
                        <group string="Client et réservation">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="description"/>
                            <field name="reservation_ref"/>
                            <field name="payment_ref"/>
                            <field name="failure_reason"/>
                        </group>
                    </group>
                    <group string="Suivi" invisible="not has_anomaly and refund_status == 'none'">
                        <field name="has_anomaly"/>
                        <field name="anomaly_note" invisible="not has_anomaly"/>
                        <field name="refund_status"/>
                        <field name="refund_ref"/>
                    </group>
                    <notebook>
                        <page string="Historique" name="events">
                            <field name="event_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="type"/>
                                    <field name="from_status"/>
                                    <field name="to_status"/>
                                    <field name="source"/>
                                    <field name="event_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="eduloc_payment_view_search" model="ir.ui.view">
        <field name="name">eduloc.payment.search</field>
        <field name="model">eduloc.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="payment_ref"/>
                <field name="reservation_ref"/>
                <field name="provider_ref"/>
                <filter name="pending" string="En cours" domain="[('status', '=', 'pending')]"/>
                <filter name="succeeded" string="Réussis" domain="[('status', '=', 'succeeded')]"/>
                <filter name="failed" string="Échoués / annulés" domain="[('status', 'in', ('failed', 'cancelled', 'expired'))]"/>
                <filter name="anomaly" string="Anomalies" domain="[('has_anomaly', '=', True)]"/>
                <group>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_method" string="Moyen de paiement" context="{'group_by': 'method'}"/>
                    <filter name="group_provider" string="Prestataire" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="eduloc_payment_action" model="ir.actions.act_window">
        <field name="name">Paiements</field>
        <field name="res_model">eduloc.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="eduloc_payment_view_search"/>
        <field name="context">{'search_default_anomaly': 0}</field>
    </record>

    <menuitem id="eduloc_payment_menu" name="Paiements" parent="crm.crm_menu_root" action="eduloc_payment_action" sequence="40"/>
</odoo>
