<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Icône d'onglet edUloc (backend et page de connexion) à la place de celle d'Odoo -->
    <template id="layout" inherit_id="web.layout" name="EduLoc Favicon">
        <xpath expr="//title" position="attributes">
            <attribute name="t-esc">title or 'edUloc'</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="type">image/png</attribute>
            <attribute name="t-att-href">x_icon or '/eduloc_theme/static/img/favicon.png'</attribute>
        </xpath>
    </template>

    <template id="login_layout" inherit_id="web.login_layout" name="EduLoc Login Layout">
        <!-- Carte plus large que les 300px d'origine -->
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="style">max-width: 420px;</attribute>
        </xpath>
        <!-- Baseline officielle sous le logo (même formule que le titre du hero de la landing) -->
        <xpath expr="//img[contains(@t-attf-src, 'company_logo')]" position="after">
            <p class="eduloc-baseline">Le bon accompagnement, <span>au bon endroit.</span></p>
        </xpath>
        <!-- Pied de carte : « Généré par Odoo » retiré ; le gestionnaire de bases est de toute façon désactivé -->
        <xpath expr="//div[hasclass('border-top')]" position="replace"/>
    </template>
</odoo>
