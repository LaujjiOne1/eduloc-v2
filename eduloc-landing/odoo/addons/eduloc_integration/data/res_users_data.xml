<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cahier §8 : compte technique dédié, jamais administrateur. Sans mot de passe défini,
         il ne peut pas ouvrir de session : il n'est utilisable que par l'endpoint d'intégration.
         Droits : pistes « documents personnels » (dont les pistes non assignées) + création de contacts. -->
    <record id="user_eduloc_gateway" model="res.users">
        <field name="name">EduLoc — Passerelle site (technique)</field>
        <field name="login">eduloc_gateway</field>
        <field name="email">eduloc_gateway@invalid.local</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
        <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('base.group_partner_manager')])]"/>
    </record>
</odoo>
