# Copier en .env (ignoré par Git) et remplacer chaque valeur.
# Générer un secret : openssl rand -hex 32

POSTGRES_PASSWORD=change-me
# Jeton Bearer attendu par l'endpoint /eduloc/api/v1/support-requests.
# La même valeur est à configurer côté Supabase (secret ODOO_API_TOKEN).
EDULOC_API_TOKEN=change-me

# Jeton Bearer attendu par /eduloc/api/v1/payments (module eduloc_payments), partagé avec le service de paiement
# (variable ODOO_PAYMENTS_TOKEN de eduloc-pay-subscriptions). DIFFÉRENT de EDULOC_API_TOKEN. openssl rand -hex 32
EDULOC_PAYMENTS_TOKEN=

# Port local d'Odoo (127.0.0.1 uniquement)
ODOO_HTTP_PORT=8069

# Profil prod (Nginx)
ODOO_DOMAIN=crm.example.com
LETSENCRYPT_DIR=/etc/letsencrypt
